# Copy to .env and fill in values

# Storage backend, picked in this order:
#   1. Turso   - if TURSO_DATABASE_URL is set
#   2. Postgres - if DATABASE_URL is set
#   3. Local flows.json - if neither is set

# Turso (libSQL). Use file:local.db for a local SQLite file
TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
TURSO_AUTH_TOKEN=

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@host:5432/dbname

# Editor login (auth enabled only when both are set)
NODE_RED_USERNAME=admin
NODE_RED_PASSWORD=change-me

# Row key in the "eConfigs" table (default: ashad-nodered)
APP_NAME=ashad-nodered

# HTTP port (default: 1880)
PORT=1880

# Optional: stored alongside flows on save
SECURE_LINK=

# Optional: uibuilder root dir (default: project root)
UIBROOT=

# Optional: keep-alive self-ping (on Render, RENDER_EXTERNAL_URL is used automatically)
# KEEP_ALIVE=false
# KEEP_ALIVE_URL=https://your-app.example.com/
# KEEP_ALIVE_INTERVAL=10
